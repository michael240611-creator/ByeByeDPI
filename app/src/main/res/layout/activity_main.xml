<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Фон с падающим кодом -->
    <io.github.romanvht.byedpi.utility.HackerBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Иконка настроек -->
    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_preferences"
        app:tint="#00FF88"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Утка с глитч-эффектом (красная тень) -->
    <ImageView
        android:id="@+id/duckGlitch"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/duck"
        android:alpha="0.6"
        app:tint="#FF0055"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Основная утка -->
    <ImageView
        android:id="@+id/duckImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/duck"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Заголовок -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PLUM_DUCK.exe"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:shadowColor="#00FF88"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="25"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/duckImage" />

    <!-- Статус -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="SYSTEM_HALTED"
        android:textColor="#00FF88"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText" />

    <!-- Главная кнопка -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statusButtonCard"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="110dp"
        app:cardBackgroundColor="#0A0A0A"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText">
        
        <!-- Неоновая обводка -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/neon_circle" />
        
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <!-- Скрываем старую иконку -->
            <ImageView
                android:id="@+id/statusButtonIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
                
            <!-- Текст кнопки -->
            <TextView
                android:id="@+id/statusButtonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="START"
                android:textColor="#00FF88"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Скрытый блок, чтобы ByeDPI не падал из-за отсутствующих ID -->
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone">
        <TextView android:id="@+id/proxyAddress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/cmdButtonsRow">
            <Button android:id="@+id/editorButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/testProxyButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/domainListsButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/strategyButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/strategyButtonName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/strategyButtonText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
