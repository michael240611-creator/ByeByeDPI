<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Наша тема без Dynamic Colors -->
    <style name="Theme.ByeByeDPI" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FF0000</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#8B0000</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        
        <item name="android:windowBackground">#0A0000</item>
        <item name="colorSurface">#1A0000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        
        <item name="android:statusBarColor">#0A0000</item>
        <item name="android:navigationBarColor">#0A0000</item>
    </style>

    <!-- Восстанавливаем стиль для оригинального кода ByeDPI -->
    <style name="SmallShadowCard">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

</resources>
